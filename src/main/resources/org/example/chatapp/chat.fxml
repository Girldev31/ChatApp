<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600" prefWidth="1000" style="-fx-background-color: #f3efff;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.chatapp.ChatController">

    <!-- ===== BARRE ICÔNES VERTICALE ===== -->
    <VBox alignment="TOP_CENTER" layoutX="0" layoutY="0" prefHeight="600" prefWidth="70" spacing="30" style="-fx-background-color: #6a3bbf; -fx-padding: 30 0 0 0;">

        <Button style="-fx-background-color: transparent;                        -fx-font-size: 20px;                        -fx-text-fill: white;" text="💬" />

        <Button style="-fx-background-color: transparent;                        -fx-font-size: 20px;                        -fx-text-fill: white;" text="👥" />

        <Button style="-fx-background-color: transparent;                        -fx-font-size: 20px;                        -fx-text-fill: white;" text="⚙" />

        <Pane VBox.vgrow="ALWAYS" />

        <Button style="-fx-background-color: transparent;                        -fx-font-size: 20px;                        -fx-text-fill: white;" text="🚪" />
    </VBox>


    <!-- ===== SIDEBAR CONTACTS ===== -->
    <VBox layoutX="70.0" prefHeight="600" prefWidth="250" style="-fx-background-color: #8a4fff;">

        <Label style="-fx-text-fill: white;                       -fx-font-size: 20px;                       -fx-font-weight: bold;                       -fx-padding: 20;" text="FB Chat" />

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" prefHeight="70" spacing="15" style="-fx-background-color: #6a3bbf;                      -fx-padding: 0 20 0 20;">

            <Label style="-fx-text-fill: white;                           -fx-font-size: 18px;                           -fx-font-weight: bold;" text="Discussion" />

            <Pane HBox.hgrow="ALWAYS" />

            <!-- ICÔNES HEADER -->
            <Button style="-fx-background-color: transparent;                            -fx-text-fill: white;                            -fx-font-size: 16px;" text="📞" />

            <Button style="-fx-background-color: transparent;                            -fx-text-fill: white;                            -fx-font-size: 16px;" text="🎥" />

            <Button style="-fx-background-color: transparent;                            -fx-text-fill: white;                            -fx-font-size: 18px;" text="⋮" />
        </HBox>

        <TextField promptText="Rechercher..." style="-fx-background-radius: 20;                           -fx-background-color: white;                           -fx-padding: 8;                           -fx-margin: 10;" />

        <ListView fx:id="contactsList" style="-fx-background-color: transparent;                          -fx-control-inner-background: #8a4fff;                          -fx-text-fill: white;" VBox.vgrow="ALWAYS" />
    </VBox>


    <!-- ===== ZONE CHAT ===== -->
    <VBox layoutX="320" layoutY="0" prefHeight="600" prefWidth="680" style="-fx-background-color: white;">


        <!-- MESSAGES -->
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">

            <VBox fx:id="messagesBox" spacing="15" style="-fx-padding: 20;" />
        </ScrollPane>


        <!-- BARRE MESSAGE BAS -->
        <HBox alignment="CENTER" prefHeight="70" spacing="10" style="-fx-background-color: #f3efff;                      -fx-padding: 10 15 10 15;">

            <Button style="-fx-background-color: transparent;                            -fx-font-size: 18px;" text="😊" />

            <TextField fx:id="messageField" promptText="Écrire un message..." style="-fx-background-radius: 25;                               -fx-background-color: white;                               -fx-padding: 10;" HBox.hgrow="ALWAYS" />

            <Button style="-fx-background-color: transparent;                            -fx-font-size: 18px;" text="📎" />

            <Button onAction="#sendMessage" prefHeight="40" prefWidth="40" style="-fx-background-color: #8a4fff;                            -fx-text-fill: white;                            -fx-background-radius: 50%;                            -fx-font-size: 14px;" text="➤" />
        </HBox>

    </VBox>

</AnchorPane>
