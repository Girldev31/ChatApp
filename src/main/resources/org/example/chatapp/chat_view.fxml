<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane prefHeight="600" prefWidth="1000"
            style="-fx-background-color: #f3efff;"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.chatapp.ChatController">

    <!-- ===== BARRE ICONES GAUCHE ===== -->
    <VBox alignment="TOP_CENTER"
          AnchorPane.topAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.bottomAnchor="0"
          prefWidth="70"
          spacing="30"
          style="-fx-background-color: #3D1A47; -fx-padding: 30 0 0 0;">

        <Button text="💬"
                style="-fx-background-color: transparent; -fx-font-size: 20px; -fx-text-fill: white;" />
        <Button text="👥"
                style="-fx-background-color: transparent; -fx-font-size: 20px; -fx-text-fill: white;" />
        <Button text="⚙"
                style="-fx-background-color: transparent; -fx-font-size: 20px; -fx-text-fill: white;" />

        <Pane VBox.vgrow="ALWAYS"/>

        <Button fx:id="logoutButton"
                text="🚪"
                onAction="#logout"
                style="-fx-background-color: transparent; -fx-font-size: 20px;
                       -fx-text-fill: white; -fx-cursor: hand;" />
        <Pane prefHeight="15"/>
    </VBox>

    <!-- ===== SIDEBAR CONTACTS ===== -->
    <VBox AnchorPane.topAnchor="0"
          AnchorPane.leftAnchor="70"
          AnchorPane.bottomAnchor="0"
          prefWidth="250"
          spacing="12"
          style="-fx-background-color: #6a3bbf; -fx-padding: 18 15 15 15;">

        <!-- Titre -->
        <Label text="FB Chat"
               style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" />

        <!-- ===== BLOC PROFIL UTILISATEUR CONNECTE ===== -->
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-background-color: rgba(255,255,255,0.13);
                     -fx-background-radius: 12;
                     -fx-padding: 10 12 10 12;">

            <!-- Avatar avec point de statut — AnchorPane -->
            <AnchorPane prefWidth="42" prefHeight="42" minWidth="42" minHeight="42">

                <!-- Fond cercle avatar -->
                <Circle fx:id="avatarCircle"
                        radius="19"
                        fill="#A8D8F0"
                        AnchorPane.topAnchor="2"
                        AnchorPane.leftAnchor="2"/>

                <!-- Initiale du username -->
                <Label fx:id="avatarInitiale"
                       text="?"
                       style="-fx-text-fill: #3D1A47;
                              -fx-font-size: 15px;
                              -fx-font-weight: bold;"
                       AnchorPane.topAnchor="10"
                       AnchorPane.leftAnchor="10"/>

                <!-- 🟢 Point vert = EN LIGNE  /  ⚫ gris = HORS LIGNE -->
                <Circle fx:id="myStatusDot"
                        radius="7"
                        fill="#4ECDC4"
                        stroke="white"
                        strokeWidth="2"
                        AnchorPane.bottomAnchor="0"
                        AnchorPane.rightAnchor="0"/>

            </AnchorPane>

            <!-- Nom + texte statut -->
            <VBox spacing="4" HBox.hgrow="ALWAYS">

                <Label fx:id="currentUserLabel"
                       text="..."
                       style="-fx-text-fill: white;
                              -fx-font-size: 13px;
                              -fx-font-weight: bold;"/>

                <!-- Badge statut texte -->
                <HBox alignment="CENTER_LEFT" spacing="5"
                      style="-fx-background-color: rgba(78,205,196,0.2);
                             -fx-background-radius: 20;
                             -fx-padding: 2 8 2 6;">
                    <Circle fx:id="myStatusDotBadge"
                            radius="4"
                            fill="#4ECDC4"/>
                    <Label fx:id="myStatusLabel"
                           text="En ligne"
                           style="-fx-text-fill: #4ECDC4;
                                  -fx-font-size: 10px;
                                  -fx-font-weight: bold;"/>
                </HBox>

            </VBox>
        </HBox>

        <!-- Séparateur -->
        <Separator style="-fx-opacity: 0.3;"/>

        <!-- Barre de recherche -->
        <TextField fx:id="searchField"
                   promptText="🔍  Rechercher..."
                   style="-fx-background-radius: 20;
                          -fx-background-color: rgba(255,255,255,0.15);
                          -fx-text-fill: white;
                          -fx-prompt-text-fill: rgba(255,255,255,0.5);
                          -fx-padding: 8 14 8 14;
                          -fx-border-color: transparent;"/>

        <!-- Label section contacts -->
        <Label text="CONTACTS"
               style="-fx-text-fill: rgba(255,255,255,0.45);
                      -fx-font-size: 9px;
                      -fx-font-weight: bold;
                      -fx-padding: 2 0 0 4;"/>

        <!-- Liste contacts -->
        <ListView fx:id="contactsList"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: transparent;
                         -fx-control-inner-background: transparent;
                         -fx-border-color: transparent;"/>
    </VBox>

    <!-- ===== ZONE CHAT PRINCIPALE ===== -->
    <VBox AnchorPane.topAnchor="0"
          AnchorPane.leftAnchor="320"
          AnchorPane.rightAnchor="0"
          AnchorPane.bottomAnchor="0"
          style="-fx-background-color: white;">

        <!-- Header contact sélectionné -->
        <HBox fx:id="chatHeader"
              prefHeight="70"
              alignment="CENTER_LEFT"
              spacing="12"
              visible="false"
              managed="false"
              style="-fx-background-color: #6a3bbf; -fx-padding: 0 20 0 20;">

            <!-- Avatar contact dans le header -->
            <AnchorPane prefWidth="42" prefHeight="42" minWidth="42" minHeight="42">
                <Circle radius="19" fill="#A8D8F0"
                        AnchorPane.topAnchor="2" AnchorPane.leftAnchor="2"/>
                <Label fx:id="contactInitiale"
                       text="?"
                       style="-fx-text-fill: #3D1A47; -fx-font-size: 15px; -fx-font-weight: bold;"
                       AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10"/>
                <!-- Point statut du contact -->
                <Circle fx:id="contactStatusDot"
                        radius="7" fill="#4ECDC4"
                        stroke="white" strokeWidth="2"
                        AnchorPane.bottomAnchor="0" AnchorPane.rightAnchor="0"/>
            </AnchorPane>

            <VBox spacing="2">
                <Label fx:id="usernameLabel"
                       text="Utilisateur"
                       style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
                <Label fx:id="contactStatusLabel"
                       text="En ligne"
                       style="-fx-text-fill: #4ECDC4; -fx-font-size: 11px;"/>
            </VBox>

            <Pane HBox.hgrow="ALWAYS"/>

            <Button text="📞"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px;" />
            <Button text="🎥"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px;" />
            <Button text="⋮"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 18px;" />
        </HBox>

        <!-- Zone messages (AnchorPane) -->
        <AnchorPane VBox.vgrow="ALWAYS">

            <VBox fx:id="welcomeBox"
                  alignment="CENTER"
                  spacing="10"
                  AnchorPane.topAnchor="0"
                  AnchorPane.bottomAnchor="0"
                  AnchorPane.leftAnchor="0"
                  AnchorPane.rightAnchor="0">
                <Label text="Bienvenue 👋"
                       style="-fx-font-size: 26px; -fx-font-weight: bold;" />
                <Label text="Choisissez un contact pour commencer une discussion."
                       style="-fx-text-fill: #888;" />
            </VBox>

            <ScrollPane fx:id="messagesScroll"
                        fitToWidth="true"
                        visible="false"
                        managed="false"
                        AnchorPane.topAnchor="0"
                        AnchorPane.bottomAnchor="0"
                        AnchorPane.leftAnchor="0"
                        AnchorPane.rightAnchor="0"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox fx:id="messagesBox"
                      spacing="10"
                      style="-fx-padding: 20;" />
            </ScrollPane>

        </AnchorPane>

        <!-- Barre de saisie -->
        <HBox fx:id="messageBar"
              alignment="CENTER"
              prefHeight="70"
              spacing="10"
              visible="false"
              managed="false"
              style="-fx-background-color: #f3efff; -fx-padding: 10 15 10 15;">

            <Button text="😊"
                    style="-fx-background-color: transparent; -fx-font-size: 18px;" />

            <TextField fx:id="messageField"
                       promptText="Écrire un message..."
                       HBox.hgrow="ALWAYS"
                       style="-fx-background-radius: 25;
                              -fx-background-color: white;
                              -fx-padding: 10;" />

            <Button text="📎"
                    style="-fx-background-color: transparent; -fx-font-size: 18px;" />

            <Button text="➤"
                    onAction="#sendMessage"
                    prefHeight="40"
                    prefWidth="40"
                    style="-fx-background-color: #8a4fff;
                           -fx-text-fill: white;
                           -fx-background-radius: 50%;
                           -fx-font-size: 14px;" />
        </HBox>

    </VBox>

</AnchorPane>
