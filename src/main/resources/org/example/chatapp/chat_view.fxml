<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.chatapp.ChatController"
            prefWidth="1000" prefHeight="600"
            style="-fx-background-color: #f3efff;">


    <VBox layoutX="0" layoutY="0"
          prefWidth="70" prefHeight="600"
          alignment="TOP_CENTER"
          spacing="30"
          style="-fx-background-color: #6a3bbf; -fx-padding: 30 0 0 0;">

        <Button text="💬"
                style="-fx-background-color: transparent;
                       -fx-font-size: 20px;
                       -fx-text-fill: white;"/>

        <Button text="👥"
                style="-fx-background-color: transparent;
                       -fx-font-size: 20px;
                       -fx-text-fill: white;"/>

        <Button text="⚙"
                style="-fx-background-color: transparent;
                       -fx-font-size: 20px;
                       -fx-text-fill: white;"/>

        <Pane VBox.vgrow="ALWAYS"/>

        <Button text="🚪"
                style="-fx-background-color: transparent;
                       -fx-font-size: 20px;
                       -fx-text-fill: white;"/>
    </VBox>


    <!-- ===== SIDEBAR CONTACTS ===== -->
    <VBox layoutX="70" layoutY="0"
          prefWidth="250" prefHeight="600"
          style="-fx-background-color: #8a4fff;">

        <Label text="FB Chat"
               style="-fx-text-fill: white;
                      -fx-font-size: 20px;
                      -fx-font-weight: bold;
                      -fx-padding: 20;" />

        <TextField promptText="Rechercher..."
                   style="-fx-background-radius: 20;
                          -fx-background-color: white;
                          -fx-padding: 8;
                          -fx-margin: 10;" />

        <ListView fx:id="contactsList"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: transparent;
                         -fx-control-inner-background: #8a4fff;
                         -fx-text-fill: white;" />
    </VBox>


    <!-- ===== ZONE CHAT ===== -->
    <VBox layoutX="320" layoutY="0"
          prefWidth="680" prefHeight="600"
          style="-fx-background-color: white;">

        <!-- HEADER -->
        <HBox prefHeight="70"
              alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-background-color: #6a3bbf;
                     -fx-padding: 0 20 0 20;">

            <Label text="Discussion"
                   style="-fx-text-fill: white;
                          -fx-font-size: 18px;
                          -fx-font-weight: bold;" />

            <Pane HBox.hgrow="ALWAYS"/>

            <!-- ICÔNES HEADER -->
            <Button text="📞"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 16px;"/>

            <Button text="🎥"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 16px;"/>

            <Button text="⋮"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 18px;"/>
        </HBox>


        <!-- MESSAGES -->
        <ScrollPane fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent;">

            <VBox fx:id="messagesBox"
                  spacing="15"
                  style="-fx-padding: 20;" />
        </ScrollPane>


        <!-- BARRE MESSAGE BAS -->
        <HBox spacing="10"
              prefHeight="70"
              alignment="CENTER"
              style="-fx-background-color: #f3efff;
                     -fx-padding: 10 15 10 15;">

            <Button text="😊"
                    style="-fx-background-color: transparent;
                           -fx-font-size: 18px;"/>

            <TextField fx:id="messageField"
                       promptText="Écrire un message..."
                       HBox.hgrow="ALWAYS"
                       style="-fx-background-radius: 25;
                              -fx-background-color: white;
                              -fx-padding: 10;" />

            <Button text="📎"
                    style="-fx-background-color: transparent;
                           -fx-font-size: 18px;"/>

            <Button text="➤"
                    onAction="#sendMessage"
                    style="-fx-background-color: #8a4fff;
                           -fx-text-fill: white;
                           -fx-background-radius: 50%;
                           -fx-font-size: 14px;"
                    prefWidth="40"
                    prefHeight="40"/>
        </HBox>

    </VBox>

</AnchorPane>
