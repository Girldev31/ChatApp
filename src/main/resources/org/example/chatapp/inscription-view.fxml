<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="466.0" prefWidth="597.0" style="-fx-background-color: #6a0dad;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.chatapp.InscriptionController">

    <children>

        <Circle fill="#7057dd" layoutX="80.0" layoutY="102.0" radius="80" />
        <Circle fill="#7f3fe6" layoutX="149.0" layoutY="127.0" radius="40" />


        <Circle fill="#6a3bbf" layoutX="50" layoutY="620" radius="30" />
        <Circle fill="#5a2ea0" layoutX="100" layoutY="650" radius="25" />
        <Circle fill="#6a3bbf" layoutX="350" layoutY="630" radius="20" />
        <Circle fill="#5a2ea0" layoutX="300" layoutY="660" radius="15" />


        <VBox alignment="CENTER" layoutX="138.0" layoutY="137.0" prefHeight="401.0" prefWidth="320" spacing="12" style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10,0,0,5);">

            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #4b2a8c;" text="INSCRIPTION" textAlignment="CENTER" />

            <TextField fx:id="fullname_input" promptText="Nom complet" style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #e0e0e0;" />
            <TextField fx:id="email_input" promptText="Adresse email" style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #e0e0e0;" />
            <TextField fx:id="username_input" promptText="Nom d'utilisateur" style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #e0e0e0;" />
            <PasswordField fx:id="password_input" promptText="Mot de passe" style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #e0e0e0;" />
            <PasswordField fx:id="confirm_password_input" promptText="Confirmer mot de passe" style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #e0e0e0;" />

            <Button onAction="#register" prefHeight="35" prefWidth="180" style="-fx-background-color: #4b2a8c; -fx-text-fill: white; -fx-background-radius: 18;" text="S'inscrire" />

            <Label onMouseClicked="#goToLogin" style="-fx-text-fill: #4b2a8c; -fx-font-size: 12px; -fx-underline: true; -fx-cursor: hand;" text="Déjà un compte ? Se connecter" />
        </VBox>
    </children>
</AnchorPane>
